# Copy to .env, which is ignored by git. The binary reads only its process environment.

# Port the backend listens on. `just dev` sets it; Cloud Run supplies it.
PORT=8080

# Directory of the built SPA. Unset in development, where the Vite dev server serves the frontend.
# SPA_DIR=frontend/build

# Postgres. This is the local database that `just up` starts, and `just` uses it by default;
# set it here only to run `cargo test` or `cargo run` directly. In production it comes from Secret Manager.
DATABASE_URL=postgres://gold_ballot:gold_ballot@localhost:5432/gold_ballot

# Neon connection strings, never read by the app. scripts/bootstrap-gcp.sh stores the direct one as the
# production secret.
NEON_DATABASE_URL=
NEON_DATABASE_URL_POOLED=

# Telemetry. With an endpoint set, the app exports traces, logs and metrics over OTLP; `just dev` points it
# at the local Grafana stack. Unset, the app only prints JSON logs.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Export before each response instead of in the background; for debugging on Cloud Run.
# TELEMETRY_FLUSH_EACH_REQUEST=true

# Grafana Cloud's OTLP gateway and credentials, never read by the app. scripts/bootstrap-gcp.sh stores them
# as production secrets. Grafana Cloud shows both under Connections > OpenTelemetry (OTLP).
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_HEADERS=
