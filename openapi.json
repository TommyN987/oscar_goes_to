{
  "openapi": "3.1.0",
  "info": {
    "title": "The Gold Ballot API",
    "description": "The JSON API of The Gold Ballot, an Oscar prediction game.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "description": "The process is up. Answers without touching the database (spec rule 2.4.5).",
        "operationId": "liveness",
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "description": "The process can reach the database, so it can serve every request (spec rule 2.4.5).",
        "operationId": "readiness",
        "responses": {
          "204": {
            "description": "The database is reachable."
          },
          "503": {
            "description": "The database is not reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Who am I",
        "description": "The signed-in player, and whether the configuration names them an admin (spec rule 3.3.4).",
        "operationId": "who_am_i",
        "responses": {
          "200": {
            "description": "The signed-in player.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmI"
                }
              }
            }
          },
          "401": {
            "description": "The request carries no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "The server failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/sign-out": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Sign out",
        "description": "Ends every session of the signed-in player, on every device (spec rule 3.2.5).",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "The player is signed out everywhere."
          },
          "401": {
            "description": "The request carries no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "The server failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "A stable, machine-readable error code. Clients branch on it, so a code is never renamed.",
        "enum": [
          "not_found",
          "payload_too_large",
          "database_unavailable",
          "not_signed_in",
          "internal"
        ]
      },
      "Liveness": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "WhoAmI": {
        "type": "object",
        "description": "The signed-in player, as only that player sees themself.",
        "required": [
          "player_id",
          "email",
          "is_admin"
        ],
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent until the player has chosen one."
          },
          "email": {
            "type": "string"
          },
          "is_admin": {
            "type": "boolean"
          },
          "player_id": {
            "type": "integer",
            "format": "int64"
          },
          "suggested_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The name to offer while the player has chosen none."
          }
        }
      }
    }
  }
}
